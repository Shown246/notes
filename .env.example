NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/notes_dev?replicaSet=rs0&directConnection=true
# Generate your own value: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=
JWT_ISSUER=secure-notes
JWT_AUDIENCE=secure-notes-web
JWT_TTL_SECONDS=900
AUTH_LOGIN_LIMIT=20
AUTH_REGISTER_LIMIT=10
AUTH_RATE_WINDOW_MS=900000
DB_SERVER_SELECTION_TIMEOUT_MS=5000
QUERY_TIMEOUT_MS=5000
REPORT_TIMEOUT_MS=5000
SHUTDOWN_TIMEOUT_MS=10000
LOG_LEVEL=info
